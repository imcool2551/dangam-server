# ============================================
# Copy this file to terraform.tfvars and fill in values
# ============================================

# AWS Configuration
aws_region  = "ap-northeast-2"
aws_profile = "dangam"  # AWS CLI 프로필 이름

# Project Configuration
project_name = "dangam-server"
environment  = "prod"

# EC2 Configuration
instance_type = "t3.micro"  # Free tier eligible
key_name      = "your-key-name"  # AWS에서 생성한 키 페어 이름

# Domain Configuration
domain_name = "growdangams.com"
subdomain   = "api"  # api.growdangams.com

# Application Configuration
app_port     = 3000
node_version = "20"

# ============================================
# Secrets (SSM Parameter Store에 저장됨)
# ============================================

db_uri             = "mongodb+srv://username:password@cluster.mongodb.net/dbname"
jwt_secret         = "your-jwt-secret-key"
kakao_rest_api_key = "your-kakao-rest-api-key"

# Firebase service account JSON (한 줄로 minify해서 입력)
# cat service-account.json | jq -c '.' 로 minify 가능
firebase_service_account = "{\"type\":\"service_account\",\"project_id\":\"...\",\"private_key\":\"...\"}"

# GitHub Deploy Key (private key)
# GitHub repo → Settings → Deploy Keys에서 생성
# cat ~/.ssh/github_deploy_key 로 확인
github_deploy_key = "-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# ============================================
# S3 & CloudFront
# ============================================

aws_s3_bucket_name = "dangam-diary"  # 기존 S3 버킷 이름

# ============================================
# Monitoring & Alerts
# ============================================

alert_email       = "your-email@example.com"  # 알람 수신 이메일
billing_threshold = 30  # 월 비용 알람 임계값 (USD)
error_threshold   = 5   # 5분간 에러 로그 임계값 (초과 시 알람)
