# Database
DB_URI="mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority"
DB_URI_LOCAL="mongodb://localhost:27017/dangam"

# JWT
JWT_SECRET="your-jwt-secret-key"

# Kakao
KAKAO_REST_API_KEY="your-kakao-rest-api-key"

# Firebase (FCM 푸시 알림용)
# service-account.json을 한 줄로 minify: cat src/certs/service-account.json | jq -c '.'
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"..."}'

# AWS Configuration
AWS_REGION="ap-northeast-2"
AWS_PROFILE="dangam"  # ~/.aws/credentials 프로필명 (로컬용, EC2는 IAM Role 사용)
AWS_S3_BUCKET_NAME="your-s3-bucket-name"

# CloudFront (optional - S3 signed URL fallback if not set)
CLOUDFRONT_DOMAIN="d1234abcd.cloudfront.net"
